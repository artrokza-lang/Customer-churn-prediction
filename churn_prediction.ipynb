# Преобразование TotalCharges в числовой формат
def convert_total_charges(value):
    try:
        return float(value)
    except:
        return np.nan  # Возвращаем NaN вместо 0

df['TotalCharges'] = df['TotalCharges'].apply(convert_total_charges)

print("Проверка пропущенных значений ДО обработки:")
print(df.isnull().sum())

# ==================== 3. ОБРАБОТКА ПРОПУЩЕННЫХ И НЕКОРРЕКТНЫХ ЗНАЧЕНИЙ ====================
print("\n" + "="*60)
print("2. ОБРАБОТКА ПРОПУЩЕННЫХ ЗНАЧЕНИЙ")
print("="*60)

# Анализ пропусков в TotalCharges
print(f"Пропуски в TotalCharges: {df['TotalCharges'].isnull().sum()}")
print(f"Процент пропусков: {df['TotalCharges'].isnull().mean() * 100:.2f}%")

# Проверим, есть ли связь пропусков в TotalCharges с tenure
if df['TotalCharges'].isnull().sum() > 0:
    print("\nАнализ строк с пропусками в TotalCharges:")
    missing_data = df[df['TotalCharges'].isnull()]
    print(f"Средний tenure для строк с пропусками: {missing_data['tenure'].mean():.1f}")
    print(f"Минимальный tenure для строк с пропусками: {missing_data['tenure'].min():.1f}")
    print(f"Максимальный tenure для строк с пропусками: {missing_data['tenure'].max():.1f}")

    # Заполняем пропуски в TotalCharges медианой для соответствующего tenure
    df['TotalCharges'] = df.groupby('tenure')['TotalCharges'].transform(
        lambda x: x.fillna(x.median())
    )
    # Если остались пропуски, заполняем общей медианой
    df['TotalCharges'] = df['TotalCharges'].fillna(df['TotalCharges'].median())

print("\nПроверка пропущенных значений ПОСЛЕ обработки TotalCharges:")
print(df.isnull().sum())

